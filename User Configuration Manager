test_settings = {'theme': 'dark', 'notifications': 'enabled', 'volume': 'high'}

def add_setting(settings,pairs):
    key,value = pairs
     # Bcz "pairs = key,value" means assigning random or new key and value to the pairs but "key,value = pairs" means key,value present are pairs in this function.
    key_lower = key.lower()
    value_lower = value.lower()
    
    if key_lower in settings :
        return f"Setting '{key_lower}' already exists! Cannot add a new setting with this name."
    else :
        settings[key_lower] = value_lower
        return f"Setting '{key_lower}' added with value '{value_lower}' successfully!"

def update_setting(settings,pairs):
    key,value = pairs
    key_lower = key.lower()
    value_lower = value.lower()
    
    if key_lower in settings :
        settings[key_lower] = value_lower
        # ".update()" expects another dictionary or iterable, not a single string value.
        # Think of a dictionary like a real phonebook:
        # Settings is the Phonebook, ".key_lower" is the person's name (the label).
        # "value_lower" is their phone number (the data).
        return f"Setting '{key_lower}' updated to '{value_lower}' successfully!"
    else :
        return f"Setting '{key_lower}' does not exist! Cannot update a non-existing setting."

def delete_setting(settings,key):
    key_lower = key.lower()

    if key_lower in settings :
        del settings[key_lower]
        return f"Setting '{key_lower}' deleted successfully!"
    else :
        return f"Setting not found!"

def view_settings(settings):
    if not settings :
        # "if not settings" means the dictionary exists, but it is completely empty ({}), so "if not key,value in settings" is false as the dictionary is empty and no key,value pairs would be found for it to search for to understand what that format means and what key and value are exactly.        
        return f"No settings available."
    else :
        result = "Current User Settings:\n"
        for key,value in settings.items():
            result += f"{key.capitalize()}: {value}\n"
        return result
